# Copy to backend/.env and fill in. Never commit .env.
# Locally, commands load it with: uv run --env-file .env <command>

# Read-only role. Used by the app, the eval and the tests.
DATABASE_URL=postgresql://orderlens_readonly:PASSWORD@HOST/DBNAME?sslmode=require

# Owner role. Used by scripts/setup_db.py only. Never set this on the server.
OWNER_DATABASE_URL=postgresql://OWNER:PASSWORD@HOST/DBNAME?sslmode=require

# Password scripts/setup_db.py gives the orderlens_readonly role.
READONLY_PASSWORD=

# LLM
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Requests allowed per IP per minute, and in total per day.
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=300

# Optional LangSmith tracing. LangChain reads these directly from the environment.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=orderlens
